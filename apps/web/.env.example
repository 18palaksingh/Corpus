# Origins allowed to call /api/* cross-origin, comma-separated.
#
# Native mobile builds have no origin and do not need this. Expo's web target,
# and any separately-hosted client, do.
#
# With nothing set, development allows localhost only and production allows
# nothing — a wildcard default would quietly ship an open API.
CORPUS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:8081
