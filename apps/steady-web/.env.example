# Copy to .env.local (web dev) or set in your host's dashboard.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite by default — nothing to install, file lives next to the schema.
DATABASE_URL="file:./steady.db"
# Postgres, after running `node scripts/use-postgres.mjs`:
# DATABASE_URL="postgresql://user:pass@host:5432/steady?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Required. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Required in production; the full public origin of this app.
# AUTH_URL="https://steady.example.com"

# Google SSO. Leave unset and the button simply does not appear.
# Authorised redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub SSO. Callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Clients
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the API cross-origin (the Expo app in
# development, Expo web). Leave unset to allow none.
STEADY_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006"
